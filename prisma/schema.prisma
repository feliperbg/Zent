generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  cpf          String?       @unique
  birthDate    DateTime?
  emailVerified DateTime?
  verificationToken String?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  password     String
  plan         PlanType      @default(FREE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Address Fields
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  
  goals        Goal[]

  transactions Transaction[]
  vehicles     Vehicle[]
  fixedExpenses FixedExpense[]
  savedPlaces  Place[]
}

model Transaction {
  id          String    @id @default(uuid())
  amount      Decimal
  type        TxType
  description String?
  date        DateTime  @default(now())
  userId      String
  categoryId  String?
  placeId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])
  place       Place?    @relation(fields: [placeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  transactions Transaction[]
  fixedExpenses FixedExpense[]
}

model Goal {
  id            String    @id @default(uuid())
  name          String
  targetAmount  Decimal
  currentAmount Decimal   @default(0)
  deadline      DateTime?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
}

model Vehicle {
  id             String   @id @default(uuid())
  brand          String?
  model          String
  year           String?
  fuelType       FuelType
  fipeCode       String?
  avgConsumption Float
  userId         String
  user           User     @relation(fields: [userId], references: [id])
}

model Place {
  id           String        @id @default(uuid())
  name         String
  type         PlaceType
  latitude     Float
  longitude    Float
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  // No unique constraint on name anymore to avoid issues
}

enum PlanType {
  FREE
  PRO
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

enum FuelType {
  GASOLINE
  ETHANOL
  DIESEL
  ELECTRIC
  HYBRID
  FLEX
}


enum PlaceType {
  HOME
  WORK
  STORE
  OTHER
}

model FixedExpense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  day         Int
  type        TxType
  userId      String
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
}

model LocationCache {
  id          String   @id @default(uuid())
  latitude    Float
  longitude   Float
  name        String
  address     String?
  googleId    String?
  category    String?
  createdAt   DateTime @default(now())
  
  @@index([latitude, longitude])
}
